{
    "name": "train_CorPiR_X{scale}",
    "phase": "train",
    "scale": 4, // up-sampling factor: 2 | 4 | 8
    "gpu_ids": [
        0
    ],
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null // set to "experiments/<run>/checkpoint/latest" to resume
    },
    "datasets": {
        "train": {
            "name": "PathoSR",
            "dataroot": "/path/to/your/trainset", // must contain a hr_<r_resolution> sub-folder
            "datatype": "img",
            "r_resolution": 128,
            "batch_size": 32,
            "num_workers": 8,
            "use_shuffle": true,
            "data_len": -1
        },
        "val": {
            "name": "PathoSR",
            "dataroot": "/path/to/your/valset",
            "datatype": "img",
            "r_resolution": 128,
            "data_len": -1
        }
    },
    "model": {
        "finetune_norm": false,
        "liif": {
            "model_arch_name": "liif_edsr",
            "in_channel": 3,
            "out_channel": 3,
            "encoder_channel": 64,
            "model_weights_path": "./pretrained/liif_edsr_pathology.pth.tar",
            "pretrained": true
        },
        "unet": {
            "in_channel": 6,
            "out_channel": 3,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                8
            ],
            "res_blocks": 2,
            "dropout": 0.2
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "channels": 3,
            "conditional": true
        },
        "consistency_constraint": {
            "last_steps": 400 // apply the consistency constraint to the last N denoising steps
        }
    },
    "train": {
        "n_iter": 2000000,
        "val_freq": 1e4,
        "save_checkpoint_freq": 1e4,
        "print_freq": 200,
        "optimizer": {
            "type": "adam",
            "lr1": 1e-4,
            "lr2": 1e-4
        },
        "ema_scheduler": { // not used
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "CorPiR"
    }
}
